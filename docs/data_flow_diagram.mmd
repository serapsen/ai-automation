%% Mermaid diagram: Data Flow & Transformations
flowchart TB
  subgraph "Input Layer"
    A1["Campaign Brief<br/>products: 2+<br/>region, audience<br/>message<br/>languages: list"]
    A2["Brand Config<br/>colors.primary<br/>logo_path"]
    A3["Existing Assets<br/>input/assets/{product}/{aspect}/<br/>*.png, *.jpg"]
  end

  subgraph "Ingestion & Parsing"
    B1["Brief Parser<br/>load_brief()<br/>YAML/JSON to Dict"]
    B2["Asset Scanner<br/>list_existing_assets()<br/>Multi-format search"]
    B3{"Assets<br/>Found?"}
  end

  subgraph "Asset Generation"
    C1["Reuse Path<br/>Copy existing<br/>to output"]
    C2["Image Generator<br/>Per-language (en + optional)<br/>DALL·E 3 (Azure/OpenAI)"]
    C3["Fallback Generator<br/>Pillow placeholder<br/>with product name"]
    C4{"API<br/>Success?"}
  end

  subgraph "Post-Processing"
    D1["Aspect Resizing<br/>1024x1024 base<br/>Crop/resize to<br/>1x1, 9x16, 16x9"]
    D2["Text Overlay<br/>Per-language overlays<br/>(placeholders/reused only)"]
    D3["Logo Overlay<br/>Brand identity<br/>1/8 width<br/>Top-left"]
    D4["Compliance Check<br/>Brand color used?<br/>Logo present?<br/>Text moderation"]
  end

  subgraph "Output Layer"
    E1["File Organization<br/>output/{product}/{aspect}/<br/>AlphaSneaker/1x1/<br/>AlphaSneaker/9x16/<br/>AlphaSneaker/16x9/"]
    E2["Naming Convention<br/>Reused: exist_N_{lang}_final.png<br/>Generated: gen_1_{lang}_final.png"]
  end

  subgraph "Metadata & Monitoring"
    F1["Pipeline Summary<br/>products: dict<br/>aspects: list<br/>counts per aspect"]
    F2["Compliance Report<br/>text_color, logo_present<br/>checks: list"]
    F3["Agent State<br/>.processed.json<br/>mtime tracking"]
  end

  A1 --> B1
  A2 --> B1
  A3 --> B2
  B1 --> B2
  B2 --> B3
  B3 -->|Yes| C1
  B3 -->|No| C2
  C2 --> C4
  C4 -->|Yes| D1
  C4 -->|No| C3
  C1 --> D1
  C3 --> D1
  D1 --> D2
  D2 --> D3
  D3 --> D4
  D4 --> E1
  E1 --> E2
  D4 --> F1
  F1 --> F2
  F2 --> F3

  style B3 fill:#fff4e1,stroke:#f90,stroke-width:2px
  style C2 fill:#e1f5e1,stroke:#0a0,stroke-width:2px
  style C4 fill:#fff4e1,stroke:#f90,stroke-width:2px
  style D4 fill:#ffe1e1,stroke:#f00,stroke-width:2px
  style E2 fill:#e1e1ff,stroke:#00f,stroke-width:2px
