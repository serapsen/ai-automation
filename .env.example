OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
LOG_LEVEL=
FONT_PATH=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=
AZURE_BLOB_PREFIX=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your.name@yourtenant.onmicrosoft.com
SMTP_PASS=your_app_or_smtp_password
